{
  "name": "@ai-native-console/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "day21:graph": "node --import tsx src/day21-graph.ts",
    "day22:agent": "node --import tsx src/day22-agent.ts",
    "day23:checkpoint": "node --import tsx src/day23-checkpoint.ts",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@ai-native-console/contracts": "workspace:*",
    "@ai-sdk/deepseek": "3.0.74",
    "@langchain/core": "^1.3.4",
    "@langchain/langgraph": "1.7.0",
    "ai": "7.0.154",
    "fastify": "5.12.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "tsx": "4.23.15",
    "vitest": "3.2.4"
  }
}
